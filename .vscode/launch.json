{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug VmodV",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/crates/target/debug/modv",
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug headless modv-engine",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/crates/target/debug/modv-engine",
      "args": ["--headless", "--frames", "120"],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    }
  ]
}
